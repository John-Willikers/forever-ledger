{
  "name": "forever-ledger",
  "private": true,
  "version": "0.1.0",
  "description": "Collects World of Warcraft: Forever quest, item, loot and dungeon data from real play for offline analysis.",
  "author": "John-Willikers <harlanbmiltonjr@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "lint": "eslint . && prettier --check . && pnpm lint:lua",
    "lint:lua": "luacheck addon",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:lua": "cd addon/tests && lua5.1 run.lua",
    "check": "pnpm lint && pnpm typecheck && pnpm test:lua && pnpm test",
    "anonymize": "node --conditions=development --import tsx scripts/anonymize-sv.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@forever-ledger/lua-sv-parser": "workspace:*",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
