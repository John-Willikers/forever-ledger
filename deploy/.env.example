# Copy to deploy/.env (gitignored) and fill in.
POSTGRES_DB=forever_ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5440

# API (PM2 app forever-ledger-api)
DATABASE_URL=postgres://ledger:change-me@127.0.0.1:5440/forever_ledger
HOST=127.0.0.1
PORT=3410
# BODY_LIMIT=5242880
# INGEST_PER_MINUTE=120
# LOG_LEVEL=info

# Addon admin CLI (node dist/addon-cli.js publish <version>)
# GITHUB_REPO=John-Willikers/forever-ledger
# GITHUB_TOKEN=  # optional, only raises GitHub API rate limits

# Admin panel at https://ledger.willikers.dev/admin/ (Battle.net login; see README "Admin panel").
# Login stays off (503) until BNET_CLIENT_ID is set; then BNET_CLIENT_SECRET and COOKIE_SECRET are required.
# BNET_CLIENT_ID=
# BNET_CLIENT_SECRET=
# BNET_REDIRECT_URI=https://ledger.willikers.dev/admin/auth/callback
# Exact BattleTags (case-sensitive, with #number), comma-separated, made admin on login. Once your account has
# logged in it is pinned by its Battle.net account id, so this can be emptied afterwards.
# Keep the double quotes: unquoted, everything from # on is read as a comment.
# ADMIN_BATTLETAGS="JohnWilliker#1292"
# Signs cookies and CSRF tokens; at least 32 characters: openssl rand -hex 32
# COOKIE_SECRET=
# Local http development only (drops the cookies' Secure flag). Never in production.
# COOKIE_INSECURE=1
# Built admin SPA; default apps/admin/dist
# ADMIN_DIST_DIR=
