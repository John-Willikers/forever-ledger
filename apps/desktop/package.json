{
  "name": "@forever-ledger/desktop",
  "productName": "Forever Ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Forever Ledger tray app: uploads SavedVariables and keeps the ForeverLedger addon up to date.",
  "author": "John-Willikers <harlanbmiltonjr@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
