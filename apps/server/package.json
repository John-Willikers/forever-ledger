{
  "name": "@forever-ledger/server",
  "version": "0.1.0",
  "private": true,
  "description": "Forever Ledger ingest + analysis API (Fastify, Drizzle, Postgres).",
  "author": "John-Willikers <harlanbmiltonjr@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "node --conditions=development --import tsx src/main.ts",
    "db:generate": "drizzle-kit generate",
    "token:mint": "node dist/tokens-cli.js mint",
    "token:list": "node dist/tokens-cli.js list",
    "token:revoke": "node dist/tokens-cli.js revoke",
    "addon": "node dist/addon-cli.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@forever-ledger/contracts": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@forever-ledger/lua-sv-parser": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "fflate": "^0.8.3",
    "testcontainers": "^12.1.0"
  }
}
